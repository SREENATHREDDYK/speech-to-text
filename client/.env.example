# Leave both empty for local development: Vite proxies /transcripts and /ws to http://localhost:5000.
# Set them in production (for example in the Vercel project settings). These URLs are public, never put secrets here.
VITE_API_BASE_URL=https://your-backend.onrender.com
VITE_WS_URL=wss://your-backend.onrender.com/ws
