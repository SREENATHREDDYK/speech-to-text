PORT=
NODE_ENV=

# PostgreSQL connection string. Add ?sslmode=verify-full for hosted databases (Neon, Render external URL).
DATABASE_URL=

# Gemini API key from https://aistudio.google.com/apikey (server only, never in the client)
GEMINI_API_KEY=

# Recording time limit in seconds (default 300, max 600 because a Gemini live session lasts 10 minutes)
SESSION_LIMIT_SECONDS=
# How many recordings can run at the same time (default 3)
MAX_CONCURRENT_SESSIONS=
# Extra origins allowed to open the WebSocket, comma separated. Same origin is always allowed.
ALLOWED_ORIGINS=
