{
  "name": "speech-to-text-server",
  "version": "1.0.0",
  "description": "REST API and live transcription backend for the speech-to-text app",
  "private": true,
  "type": "module",
  "main": "index.js",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "dev": "node --watch --env-file=.env index.js",
    "start": "node index.js",
    "db:migrate": "node --env-file-if-exists=.env migrate.js"
  },
  "dependencies": {
    "@google/genai": "^2.30.0",
    "express": "^5.3.0",
    "pg": "^8.23.1",
    "ws": "^8.22.0"
  }
}
